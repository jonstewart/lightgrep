prefix=/Users/jon/build
exec_prefix=${prefix}
includedir=${prefix}/include
libdir=${exec_prefix}/lib

Name: lightgrep
Description: Not the worst forensics regexp engine
URL: https://github.com/LightboxTech/liblightgrep
Version: 1.5.0

Cflags: -I${includedir}
Libs: -L${libdir} -llightgrep
Requires.private: icu-uc
